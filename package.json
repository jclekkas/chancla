{
  "name": "chancla-warfare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "start:server": "node dist-server/index.js",
    "e2e:music": "node --import tsx scripts/music-e2e.ts",
    "music:prepare": "python3 scripts/music/prepare.py && python3 scripts/music/check-seams.py",
    "e2e:music-lifecycle": "node --import tsx scripts/music-lifecycle-e2e.ts",
    "e2e:sound": "node --import tsx scripts/sound-gate-e2e.ts"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "5.0.5"
  }
}
