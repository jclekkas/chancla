# Copy to your host's environment settings. Never commit real values.

# Required in production: comma-separated site origins allowed to open a
# WebSocket. Anything else gets 403.
ALLOWED_ORIGINS=https://chancla.vercel.app

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Set to 1 only behind a proxy you trust (Fly, Render, a load balancer) so
# per-IP limits use X-Forwarded-For instead of the proxy's address.
TRUST_PROXY=1

# Abuse limits (defaults shown).
MAX_CONN_PER_IP=12
MAX_ROOMS=300

# Test-only overrides; leave unset in production.
# MATCH_DURATION_MS=300000
# MATCH_SCORE_TO_WIN=25
# MATCH_COUNTDOWN_MS=3000
